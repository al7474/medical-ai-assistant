# Database Configuration
DATABASE_URL=postgresql+asyncpg://medical_user:medical_pass@localhost:5433/medical_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# AI Configuration (Choose one)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Or use Anthropic Claude instead
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# AI Model Selection
AI_PROVIDER=openai  # Options: openai, anthropic
AI_MODEL=gpt-3.5-turbo  # or gpt-4, claude-3-sonnet-20240229, etc.

# Security (JWT Authentication - Phase 5)
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
