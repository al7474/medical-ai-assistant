# Production Environment Variables
# Copy this file to .env and fill in your actual values

# AI Configuration (REQUIRED)
GEMINI_API_KEY=your-actual-gemini-api-key-here

# Security (REQUIRED - Generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production-please-use-openssl-rand-hex-32

# Database (Optional - defaults are fine for Docker)
# DATABASE_URL=postgresql+asyncpg://medical_user:medical_pass@db:5432/medical_db

# AI Model Selection (Optional)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash

# JWT Token Expiration (Optional - default 7 days)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
